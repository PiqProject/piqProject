# ============================================================
# PIQ Project - Environment Variables
# Copy this file to .env and fill in your actual values
# ============================================================

# ==================== Database ====================
DB_URL=jdbc:postgresql://localhost:5433/piqdb
DB_USERNAME=exampleuser
DB_PASSWORD=examplepassword
DB_NAME=piqdb
DB_PORT=5433

# ==================== Redis ====================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# ==================== JWT ====================
# Base64-encoded secret key (minimum 256 bits recommended)
JWT_SECRET=cGxxLXByb2plY3Qtc2VjcmV0LWtleS1mb3Itand0LWF1dGhlbnRpY2F0aW9uLXN5c3RlbS1zcHJpbmctYm9vdA

# ==================== CORS ====================
# Comma-separated list of allowed origins
CORS_ORIGINS=http://localhost:3000

# ==================== Hibernate / DDL ====================
# Options: update (default), validate, create, create-drop, none
DDL_AUTO=create-drop
# Set to 'always' on first run to seed data, then change to 'never'
SQL_INIT_MODE=never

# ==================== Admin Account ====================
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=asdf1234!

# ==================== Kakao OAuth ====================
KAKAO_CLIENT_ID=your-kakao-client-id
KAKAO_CLIENT_SECRET=your-kakao-client-secret
KAKAO_ADMIN_KEY=your-kakao-admin-key
KAKAO_REDIRECT_URI=http://localhost:3000/oauth/callback/kakao
KAKAO_API_KEY=your-kakao-api-key

# ==================== Google OAuth ====================
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=

# ==================== PortOne V2 (Payment) ====================
PORTONE_V2_SECRET=your-portone-v2-secret
PORTONE_V2_STORE_ID=your-portone-v2-store-id

# ==================== PortOne (I'mport) ====================
PORTONE_API_CODE=imp00000000
PORTONE_API_KEY=your-portone-api-key
PORTONE_API_SECRET=your-portone-api-secret

# ==================== S3 / Object Storage ====================
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
S3_BUCKET=your-bucket-name
S3_ACCESS_KEY=your-s3-access-key
S3_SECRET_KEY=your-s3-secret-key

# ==================== Firebase ====================
FCM_KEY_PATH=firebase/serviceAccountKey.json

# ==================== File Upload ====================
UPLOAD_DIR=./uploads/
